# ==========================================
# TrueSentry & TrueForge Environment Config
# ==========================================

# Server Configuration
PORT=8790
NODE_ENV=development

# TrueForge Harness Settings
STANDALONE=true
TRUEFORGE_STORAGE_TYPE=sqlite
TRUEFORGE_DB_PATH=./data/truesentry.db

# LLM Provider API Keys (Optional - Self-Contained Mock Mode Runs With 0 Keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MCP Live Integrations (Optional - Toggles from Mock to Live Infrastructure)
USE_LIVE_MCP=false
PROMETHEUS_URL=http://localhost:9090
POSTGRES_URL=postgresql://user:password@localhost:5432/orders_db
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
